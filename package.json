{
  "name": "ngo-volunteer-management",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n API,WEB -c green,blue \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm start -w server",
    "seed": "npm run seed -w server",
    "test": "node --test tests/*.test.js",
    "local": "concurrently -n API,WEB \"node scripts/local.js\" \"npm run dev -w client -- --host 127.0.0.1\"",
    "import:roster": "node scripts/import-roster.js"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "mongodb-memory-server": "^10.2.0",
    "prettier": "^3.9.9"
  },
  "type": "module"
}
